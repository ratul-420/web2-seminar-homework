<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="/css/minty.min.css">
    </head>
    <body>
        <nav class="container d-flex flex-wrap align-items-center gap-3 py-3" aria-label="Main navigation">
            <a href="/">Home</a><a href="/contact">Contact</a>
            <% if(user){ %><a href="/user">User</a> <% } %>
            <% if(user && user.role=="admin"){ %><a href="/admin">Admin</a> <% } %>
            <% if(!user){ %><a href="/login">Login</a> <a href="/register">Register</a> <% }else{ %>
            <%= user.username %> <a href="/logout">Logout</a> <% } %>
            <% if (user) { %>
                <a href="/messages">Messages</a>
            <% } %>
        </nav>
        <hr>